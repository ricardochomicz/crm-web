# Empty uses the same origin. Vite proxies /api and /sanctum during development.
VITE_API_URL=
API_PROXY_TARGET=http://localhost:8000

# Configure these to activate WebSocket updates; without them the inbox uses polling.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
